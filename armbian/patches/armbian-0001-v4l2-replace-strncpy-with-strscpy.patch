From be3b87471b3eabbf2f964555de68ca35cb93fb80 Mon Sep 17 00:00:00 2001
From: EvilOlaf <werner@armbian.com>
Date: Tue, 20 Oct 2026 17:40:40 +0200
Subject: [PATCH] v4l2: replace strncpy with strscpy

Linux 7.2 removes strncpy(). Fix the build on 7.2 and later.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 driver/if/v4l2/mvx_ext_v4l2.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/driver/if/v4l2/mvx_ext_v4l2.c b/driver/if/v4l2/mvx_ext_v4l2.c
index b66b07a..b94c9b8 100755
--- a/driver/if/v4l2/mvx_ext_v4l2.c
+++ b/driver/if/v4l2/mvx_ext_v4l2.c
@@ -122,7 +122,7 @@ static int mvx_ext_if_register_device(struct mvx_ext_if *ext,
                 V4L2_CAP_VIDEO_M2M_MPLANE |
                 V4L2_CAP_EXT_PIX_FORMAT |
                 V4L2_CAP_STREAMING;
-    strncpy(ext->vdev.name, name, sizeof(ext->vdev.name));
+    strscpy(ext->vdev.name, name, sizeof(ext->vdev.name));
 
     video_set_drvdata(&ext->vdev, ext);
 
-- 
2.43.0

